<div class="d-flex justify-content-between align-items-center mb-2">
  <h3 class="mb-0">Alumnos</h3>
  <div class="d-flex gap-2">
   <a class="btn btn-outline-secondary" href="/students/export">Extraer archivo (Excel)</a>

<a class="btn btn-outline-success" href="/students/import">
  Importar Excel
</a>

<a class="btn btn-primary" href="/students/new">+ Nuevo alumno</a>
  </div>
</div>

<form class="row g-2 mb-3" method="get" action="/students">
  <div class="col-12 col-md-3">
    <select class="form-select" name="campus_id">
      <option value="">Campus (Todos)</option>
      <% campuses.forEach(c => { %>
        <option value="<%= c.id %>" <%= String(filters.campus_id)===String(c.id) ? 'selected':'' %>><%= c.name %></option>
      <% }) %>
    </select>
  </div>

  <div class="col-12 col-md-2">
    <select class="form-select" name="shift_id">
      <option value="">Turno (Todos)</option>
      <% shifts.forEach(s => { %>
        <option value="<%= s.id %>" <%= String(filters.shift_id)===String(s.id) ? 'selected':'' %>><%= s.name %></option>
      <% }) %>
    </select>
  </div>

  <div class="col-12 col-md-2">
    <select class="form-select" name="period_id">
      <option value="">Periodo (Todos)</option>
      <% periods.forEach(p => { %>
        <option value="<%= p.id %>" <%= String(filters.period_id)===String(p.id) ? 'selected':'' %>><%= p.name %></option>
      <% }) %>
    </select>
  </div>

  <div class="col-12 col-md-2">
    <select class="form-select" name="year_id">
      <option value="">Año (Todos)</option>
      <% years.forEach(y => { %>
        <option value="<%= y.id %>" <%= String(filters.year_id)===String(y.id) ? 'selected':'' %>><%= y.year %></option>
      <% }) %>
    </select>
  </div>
<div class="col-12 col-md-2">
  <select class="form-select" name="status">
    <option value="">Activos</option>

    <option value="GRADUATED"
      <%= filters.status === 'GRADUATED' ? 'selected' : '' %>>
      Egresados
    </option>

    <option value="ALL"
      <%= filters.status === 'ALL' ? 'selected' : '' %>>
      Todos
    </option>
  </select>
</div>
  <div class="col-12 col-md-3">
    <input class="form-control" name="q" placeholder="Buscar (nombre/teléfono)" value="<%= filters.q || '' %>">
  </div>

  <div class="col-12 d-flex justify-content-end">
    <button class="btn btn-secondary" type="submit">Filtrar</button>
  </div>
</form>
<form method="POST" action="/students/graduate-filtered"
      onsubmit="return confirm('¿Seguro que deseas egresar todos los alumnos filtrados por periodo y año?');"
      class="mb-3 d-flex justify-content-end gap-2">

  <input type="hidden" name="campus_id" value="<%= filters.campus_id || '' %>">
  <input type="hidden" name="shift_id" value="<%= filters.shift_id || '' %>">
  <input type="hidden" name="period_id" value="<%= filters.period_id || '' %>">
  <input type="hidden" name="year_id" value="<%= filters.year_id || '' %>">

  <button type="submit" class="btn btn-outline-secondary">
    Egresar periodo filtrado
  </button>
</form>
<form method="POST" action="/students/delete-multiple" id="bulkDeleteForm">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="selectAllStudents">
      <label class="form-check-label" for="selectAllStudents">
        Seleccionar todos
      </label>
    </div>

    <button class="btn btn-danger" type="submit" onclick="return confirm('¿Eliminar los alumnos seleccionados?')">
      Eliminar seleccionados
    </button>
  </div>

  <div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
      <thead>
        <tr>
          <th style="width:40px;"></th>
          <th>Nombre</th>
          <th>Campus</th>
          <th>Turno</th>
          <th>Periodo/Año</th>
          <th>Paquete</th>
          <th>Saldo</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% students.forEach(s => { %>
          <tr>
            <td>
              <input
                class="form-check-input student-checkbox"
                type="checkbox"
                name="student_ids"
                value="<%= s.id %>">
            </td>
            <td>
              <%= s.full_name %>
              <div class="text-muted small"><%= s.phone_e164 %></div>
            </td>
            <td><%= s.campus_name || '' %></td>
            <td><%= s.shift_name || '' %></td>
            <td><%= (s.period_name || '') %> / <%= (s.grad_year || '') %></td>
            <td><%= s.package_name || '' %></td>
            <td>$<%= Number(s.balance || 0).toFixed(2) %></td>
            <td class="text-end">
              <a class="btn btn-sm btn-outline-primary" href="/students/<%= s.id %>">Ver</a>
              <a class="btn btn-sm btn-primary" href="/students/<%= s.id %>/edit">Editar</a>
<form method="POST"
      action="/students/<%= s.id %>/graduate"
      style="display:inline;"
      onsubmit="return confirm('¿Marcar alumno como egresado?');">

  <button type="submit"
          class="btn btn-sm btn-outline-secondary">
    Egresar
  </button>
</form>
              <form method="POST" action="/students/<%= s.id %>/delete" style="display:inline;" onsubmit="return confirm('¿Seguro que deseas eliminar este alumno?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</form>

<script>
  const selectAllStudents = document.getElementById("selectAllStudents");
  const studentCheckboxes = document.querySelectorAll(".student-checkbox");

  if (selectAllStudents) {
    selectAllStudents.addEventListener("change", function () {
      studentCheckboxes.forEach(cb => {
        cb.checked = selectAllStudents.checked;
      });
    });
  }
</script>
