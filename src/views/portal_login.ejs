<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >

  <title>Portal del estudiante | ITCC</title>

  <style>
    :root {
      --itcc-purple: #4400B2;
      --itcc-dark: #17004f;
      --itcc-deep: #0d0036;
      --itcc-yellow: #ffc400;
      --itcc-white: #ffffff;
      --itcc-soft-white: rgba(255, 255, 255, 0.78);
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      min-height: 100%;
      margin: 0;
    }

    body {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  color: var(--itcc-white);

  background:
    radial-gradient(
      circle at 50% 5%,
      rgba(79, 15, 170, 0.42) 0%,
      transparent 40%
    ),
    linear-gradient(
      180deg,
      #160044 0%,
      #240068 42%,
      #31008a 72%,
      #1a0053 100%
    );

  overflow-x: hidden;
}

    .login-page {
      position: relative;
      min-height: 100vh;
      min-height: 100svh;

      display: flex;
      justify-content: center;
      align-items: center;

      padding:
        max(30px, env(safe-area-inset-top))
        22px
        max(38px, env(safe-area-inset-bottom));

      isolation: isolate;
    }

.background-overlay {
  position: absolute;
  inset: 0;
  z-index: -3;

  background:
    linear-gradient(
      180deg,
      rgba(15, 0, 55, 0.05) 0%,
      rgba(19, 0, 65, 0.14) 48%,
      rgba(13, 0, 48, 0.38) 100%
    );
}

   .leopard-watermark{

    position:absolute;

    top:-40px;

    left:-170px;

    width:650px;

    height:900px;

    background:url("/images/Leopardo-Login.png") no-repeat;

    background-size:contain;

    background-position:left top;

    opacity:.13;

    filter:
        grayscale(1)
        hue-rotate(245deg)
        saturate(2)
        brightness(.65);

    pointer-events:none;

    z-index:-2;
}

   .diagonal-lines {
  position: absolute;
  top: 185px;
  right: -165px;

  width: 410px;
  height: 650px;

  transform: rotate(38deg);

  background:
    repeating-linear-gradient(
      90deg,
      rgba(116, 58, 219, 0.13) 0,
      rgba(116, 58, 219, 0.13) 7px,
      transparent 7px,
      transparent 31px
    );

  z-index: -2;
  pointer-events: none;
}
.login-card {

  width: min(100%, 520px);

  text-align: center;

}

    .brand-area {
      margin-bottom: 42px;
    }

.logo-box {
  width: min(82%, 350px);
  margin: 0 auto 24px;
}

.logo-box img {
  display: block;
  width: 100%;
  max-height: 145px;
  object-fit: contain;
}

    .graduation-icon {
      width: 68px;
      height: 68px;

      margin: 0 auto 12px;

      display: flex;
      justify-content: center;
      align-items: center;

      color: var(--itcc-yellow);
    }

    .graduation-icon svg {
      width: 100%;
      height: 100%;
    }

    .portal-title {
      margin: 0;

      font-size: clamp(31px, 7vw, 47px);
      line-height: 1.05;
      font-weight: 800;
      letter-spacing: -1.2px;
    }

    .portal-subtitle {
      margin: 17px 0 0;

      color: var(--itcc-soft-white);

      font-size: clamp(18px, 4.7vw, 27px);
      font-weight: 400;
    }

    .login-form {
      margin-top: 44px;
    }

    .field {
      position: relative;
      margin-bottom: 24px;
    }

    .field input {
      width: 100%;
      height: 66px;

      padding: 0 64px 0 30px;

      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 20px;

      color: #ffffff;
      background:
        linear-gradient(
          145deg,
          rgba(255,255,255,.095),
          rgba(255,255,255,.045)
        );

      font-size: 18px;
      outline: none;

      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.08),
        0 8px 28px rgba(0,0,0,.10);

      transition:
        border-color .2s ease,
        background .2s ease,
        box-shadow .2s ease;
    }

    .field input::placeholder {
      color: rgba(255, 255, 255, 0.62);
    }

    .field input:focus {
      border-color: rgba(255, 196, 0, 0.82);

      background:
        linear-gradient(
          145deg,
          rgba(255,255,255,.14),
          rgba(255,255,255,.07)
        );

      box-shadow:
        0 0 0 4px rgba(255, 196, 0, 0.12),
        0 12px 34px rgba(0,0,0,.16);
    }

    .password-toggle {
      position: absolute;
      right: 22px;
      top: 50%;

      transform: translateY(-50%);

      width: 34px;
      height: 34px;

      display: flex;
      justify-content: center;
      align-items: center;

      border: none;
      padding: 0;

      color: rgba(255,255,255,.76);
      background: transparent;

      cursor: pointer;
    }

    .password-toggle svg {
      width: 30px;
      height: 30px;
    }

    .login-button {
      width: 100%;
      height: 66px;

      margin-top: 17px;

      border: none;
      border-radius: 999px;

      color: #300080;
      background:
        linear-gradient(
          90deg,
          #ffbd00,
          #ffd21f
        );

      font-size: 20px;
      font-weight: 800;

      cursor: pointer;

      box-shadow:
        0 14px 32px rgba(255, 196, 0, 0.24);

      transition:
        transform .18s ease,
        box-shadow .18s ease,
        filter .18s ease;
    }

    .login-button:hover {
      transform: translateY(-2px);
      filter: brightness(1.04);

      box-shadow:
        0 18px 38px rgba(255, 196, 0, 0.31);
    }

    .login-button:active {
      transform: translateY(0);
    }

    .error-message {
      margin-bottom: 22px;
      padding: 14px 18px;

      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 16px;

      color: #ffffff;
      background: rgba(215, 25, 32, 0.35);

      font-size: 16px;
      text-align: left;
    }

    .footer-message {
      margin-top: 80px;
    }

    .mission {
      margin: 0;

      font-size: clamp(22px, 5vw, 32px);
      font-style: italic;
      font-weight: 700;
    }

    .hashtag {
      margin-top: 20px;

      color: var(--itcc-yellow);

      font-size: clamp(22px, 5vw, 30px);
      font-weight: 800;
      font-style: italic;
    }

    .bottom-decoration {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;

      height: 105px;

      overflow: hidden;
      pointer-events: none;
      z-index: -1;
    }

    .bottom-decoration::before {
      content: "";
      position: absolute;

      left: -8%;
      bottom: -72px;

      width: 116%;
      height: 108px;

      border-top: 15px solid var(--itcc-yellow);
      border-radius: 50% 50% 0 0;
      transform: rotate(-1deg);
    }

    .pixel-decoration {
      position: absolute;
      right: 12px;
      bottom: 57px;

      width: 120px;
      height: 110px;

      opacity: .62;

      background-image:
        linear-gradient(
          90deg,
          transparent 50%,
          rgba(255, 196, 0, .86) 50%
        ),
        linear-gradient(
          transparent 50%,
          rgba(255, 196, 0, .86) 50%
        );

      background-size: 24px 24px;
      mask-image:
        linear-gradient(
          135deg,
          transparent 15%,
          #000 80%
        );
    }

   @media (max-width: 640px) {
  .login-page {
    align-items: flex-start;

    padding:
      max(28px, env(safe-area-inset-top))
      28px
      max(75px, env(safe-area-inset-bottom));
  }

  .login-card {
    width: 100%;
    max-width: 430px;
    padding-top: 3px;
  }

  .brand-area {
    margin-bottom: 18px;
  }

  .logo-box {
    width: min(78%, 330px);
    margin-bottom: 20px;
  }

  .logo-box img {
    max-height: 132px;
  }

  .graduation-icon {
    width: 50px;
    height: 50px;
    margin-bottom: 10px;
  }

  .portal-title {
    font-size: 30px;
    letter-spacing: -0.7px;
  }

  .portal-subtitle {
    margin-top: 12px;
    font-size: 19px;
  }

  .login-form {
    margin-top: 28px;
  }

  .field {
    margin-bottom: 18px;
  }

  .field input {
    height: 64px;
    border-radius: 20px;
    padding-left: 24px;
    font-size: 18px;
  }

  .login-button {
    height: 64px;
    margin-top: 10px;
    font-size: 20px;
  }

  .footer-message {
    margin-top: 58px;
    padding-bottom: 55px;
  }

  .mission {
    font-size: 22px;
  }

  .hashtag {
    margin-top: 16px;
    font-size: 22px;
  }

  .diagonal-lines {
    top: 250px;
    right: -190px;
    width: 380px;
    height: 560px;
    opacity: 0.72;
  }

  .pixel-decoration {
    width: 92px;
    height: 88px;
    right: 3px;
    bottom: 45px;
    opacity: 0.40;
    background-size: 20px 20px;
  }

  .bottom-decoration {
    height: 82px;
  }

  .bottom-decoration::before {
    bottom: -67px;
    height: 91px;
    border-top-width: 10px;
  }
}
    @media (min-width: 900px) {
      .login-page {
        padding-top: 70px;
        padding-bottom: 90px;
      }

      .login-card {
        width: 650px;
      }
    }
  </style>
</head>

<body>

  <main class="login-page">

    <div class="background-overlay"></div>
    <div class="leopard-watermark"></div>
    <div class="diagonal-lines"></div>

    <section class="login-card">

      <div class="brand-area">

        <div class="logo-box">
          <img
            src="/images/logo-itcc.png"
            alt="Universidad y Preparatoria ITCC"
          >
        </div>

        <div class="graduation-icon" aria-hidden="true">
          <svg
            viewBox="0 0 64 64"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M6 24.5L32 12L58 24.5L32 37L6 24.5Z"
              stroke="currentColor"
              stroke-width="3.4"
              stroke-linejoin="round"
            />

            <path
              d="M17 30.5V42.5C17 47.5 23.7 51 32 51C40.3 51 47 47.5 47 42.5V30.5"
              stroke="currentColor"
              stroke-width="3.4"
              stroke-linecap="round"
            />

            <path
              d="M58 25V42"
              stroke="currentColor"
              stroke-width="3.4"
              stroke-linecap="round"
            />

            <circle
              cx="58"
              cy="46.5"
              r="3"
              fill="currentColor"
            />
          </svg>
        </div>

        <h1 class="portal-title">
          Portal del estudiante
        </h1>

        <p class="portal-subtitle">
          Accede a tu cuenta
        </p>

      </div>

      <form
        class="login-form"
        method="POST"
        action="/portal/login"
        autocomplete="on"
      >

        <% if (typeof error !== "undefined" && error) { %>
          <div class="error-message">
            <%= error %>
          </div>
        <% } %>

        <div class="field">
          <input
            type="text"
            name="username"
            placeholder="Usuario"
            autocomplete="username"
            required
          >
        </div>

        <div class="field">
          <input
            id="portalPassword"
            type="password"
            name="password"
            placeholder="Contraseña"
            autocomplete="current-password"
            required
          >

          <button
            class="password-toggle"
            id="passwordToggle"
            type="button"
            aria-label="Mostrar contraseña"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M2.5 12C4.4 8.7 7.8 6.5 12 6.5C16.2 6.5 19.6 8.7 21.5 12C19.6 15.3 16.2 17.5 12 17.5C7.8 17.5 4.4 15.3 2.5 12Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              />

              <circle
                cx="12"
                cy="12"
                r="3"
                stroke="currentColor"
                stroke-width="1.8"
              />
            </svg>
          </button>
        </div>

        <button class="login-button" type="submit">
          Entrar
        </button>

      </form>

      <footer class="footer-message">
        <p class="mission">
          Tu futuro, nuestra misión.
        </p>

        <div class="hashtag">
          #yosoyitcc
        </div>
      </footer>

    </section>

    <div class="pixel-decoration"></div>
    <div class="bottom-decoration"></div>

  </main>

  <script>
    const passwordInput =
      document.getElementById("portalPassword");

    const passwordToggle =
      document.getElementById("passwordToggle");

    if (passwordInput && passwordToggle) {
      passwordToggle.addEventListener("click", () => {
        const showing =
          passwordInput.type === "text";

        passwordInput.type =
          showing ? "password" : "text";

        passwordToggle.setAttribute(
          "aria-label",
          showing
            ? "Mostrar contraseña"
            : "Ocultar contraseña"
        );
      });
    }
  </script>

</body>
</html>
