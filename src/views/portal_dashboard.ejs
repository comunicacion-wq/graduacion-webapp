<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1">

<title>Portal del estudiante</title>

<style>

:root{

--purple:#4400B2;
--purple-dark:#17003E;
--yellow:#FFC400;
--white:#ffffff;

}

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
.portal-app {
  width: 100%;
  max-width: 760px;
  min-height: 100vh;
  margin: 0 auto;
  padding:
    max(28px, env(safe-area-inset-top))
    26px
    60px;
}

.portal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.header-brand {
  display: flex;
  align-items: center;
  gap: 20px;
}

.header-logo {
  display: block;
  width: 255px;
  max-width: 48vw;
  height: auto;
  object-fit: contain;
}

.header-divider {
  width: 1px;
  height: 74px;
  background: rgba(255, 255, 255, 0.62);
}

.header-title {
  font-size: 28px;
  line-height: 1.08;
  font-weight: 800;
  color: #ffffff;
}

.logout-button {
  position: relative;
  flex: 0 0 auto;

  width: 54px;
  height: 54px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #ffffff;
  text-decoration: none;

  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 18px;

  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
}

.logout-button svg {
  width: 32px;
  height: 32px;
}

.notification-dot {
  position: absolute;
  top: 5px;
  right: 5px;

  width: 10px;
  height: 10px;

  border-radius: 50%;
  background: #ffc400;
}

@media (max-width: 640px) {
  .portal-app {
    padding-left: 22px;
    padding-right: 22px;
  }

  .portal-header {
    gap: 12px;
  }

  .header-brand {
    gap: 13px;
  }

  .header-logo {
    width: 250px;
    max-width: 47vw;
  }

  .header-divider {
    height: 62px;
  }

  .header-title {
    font-size: 19px;
  }

  .logout-button {
    width: 48px;
    height: 48px;
    border-radius: 15px;
  }

  .logout-button svg {
    width: 28px;
    height: 28px;
  }
}
background:

linear-gradient(
rgba(15,0,60,.18),
rgba(15,0,60,.18)
),

url("/images/leopardo-login.png")

center top

cover

no-repeat;

background-color:#17003E;

color:white;

min-height:100vh;

}
/* ===== TARJETA DEL ALUMNO ===== */

.student-card{
    display:flex;
    align-items:center;
    gap:18px;
    background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.08);
    backdrop-filter:blur(16px);
    border-radius:22px;
    padding:20px;
    margin:25px 0;
}

.student-avatar{
    width:82px;
    height:82px;
    border-radius:50%;
    background:linear-gradient(180deg,#9e72ff,#ffffff);
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:40px;
    color:#4400B2;
    flex-shrink:0;
}

.student-info h3{
    margin:0;
    font-size:24px;
    font-weight:700;
    color:#fff;
}

.student-info p{
    margin:6px 0;
    color:rgba(255,255,255,.85);
    font-size:16px;
}
/* ===== BIENVENIDA ===== */

.welcome-section {
  margin-top: 55px;
}

.welcome-copy h1 {
  margin: 0;
  color: #ffffff;
  font-size: 34px;
  line-height: 1.15;
  font-weight: 800;
}

.welcome-copy p {
  margin: 8px 0 0;
  color: rgba(255,255,255,.72);
  font-size: 19px;
}

@media (max-width: 640px) {
  .welcome-section {
    margin-top: 42px;
  }

  .welcome-copy h1 {
    font-size: 27px;
  }

  .welcome-copy p {
    font-size: 16px;
  }

  .student-card {
    padding: 17px;
    gap: 14px;
  }

  .student-avatar {
    width: 76px;
    height: 76px;
    font-size: 35px;
  }

  .student-info h3 {
    font-size: 17px;
  }

  .student-info p {
    font-size: 14px;
    margin: 5px 0;
  }
}
/* ===== RESUMEN DE PAGOS ===== */

.payment-summary{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
    margin-top:25px;
}

.summary-card{
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.10);
    backdrop-filter:blur(12px);
    border-radius:20px;
    padding:20px;
    text-align:center;
}

.summary-title{
    display:block;
    color:rgba(255,255,255,.75);
    font-size:15px;
    margin-bottom:10px;
}

.summary-card h2{
    color:#fff;
    font-size:28px;
    margin:0;
    font-weight:700;
}

@media(max-width:768px){

.payment-summary{
grid-template-columns:1fr;
}

.summary-card h2{
font-size:24px;
}

}
/* ===== CONTADOR ===== */

.graduation-countdown{
    margin:28px 0;
    display:grid;
    grid-template-columns:1.3fr repeat(4,1fr);
    gap:0;
    background:rgba(255,255,255,.07);
    border:1px solid rgba(255,255,255,.10);
    border-radius:24px;
    overflow:hidden;
    backdrop-filter:blur(18px);
}

.countdown-intro{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    padding:22px;
}

.countdown-cap{
    font-size:42px;
}

.countdown-intro p{
    color:#fff;
    font-size:18px;
    line-height:1.3;
    font-weight:600;
}

.countdown-item{
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    padding:22px 10px;
    border-left:1px solid rgba(255,196,0,.35);
}

.countdown-item strong{
    font-size:48px;
    color:#fff;
    font-weight:800;
    line-height:1;
}

.countdown-item span{
    margin-top:8px;
    font-size:14px;
    color:rgba(255,255,255,.80);
}

@media(max-width:768px){

.graduation-countdown{
grid-template-columns:1fr;
}

.countdown-item{
border-left:none;
border-top:1px solid rgba(255,255,255,.08);
}

.countdown-item strong{
font-size:34px;
}

.countdown-intro{
padding:18px;
}

}
</style>

</head>

<body>

  <main class="portal-app">

    <header class="portal-header">

      <div class="header-brand">

        <img
          class="header-logo"
          src="/images/logo-itcc.png"
          alt="Universidad y Preparatoria ITCC"
        >

        <div class="header-divider"></div>

        <div class="header-title">
          Portal del<br>
          estudiante
        </div>

      </div>

      <a
        class="logout-button"
        href="/portal/logout"
        aria-label="Cerrar sesión"
      >
        <span class="notification-dot"></span>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M18 8A6 6 0 0 0 6 8c0 7-3 7-3 9h18c0-2-3-2-3-9"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <path
            d="M10 21h4"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </a>

    </header>
<section class="welcome-section">

  <div class="welcome-copy">
    <h1>
      ¡Hola,
      <%= String(student.full_name || "").split(" ")[0] %>! 👋
    </h1>

    <p>
      Bienvenido a tu portal de graduación
    </p>
  </div>
<section class="graduation-countdown">

  <div class="countdown-intro">

    <div class="countdown-cap">
      🎓
    </div>

    <p>
      Faltan para tu<br>
      graduación
    </p>

  </div>

  <div class="countdown-item">
    <strong id="countdown-days">00</strong>
    <span>DÍAS</span>
  </div>

  <div class="countdown-item">
    <strong id="countdown-hours">00</strong>
    <span>HORAS</span>
  </div>

  <div class="countdown-item">
    <strong id="countdown-minutes">00</strong>
    <span>MINUTOS</span>
  </div>

  <div class="countdown-item">
    <strong id="countdown-seconds">00</strong>
    <span>SEGUNDOS</span>
  </div>

</section>
  <article class="student-card">

    <div class="student-avatar" aria-hidden="true">
      <svg
        viewBox="0 0 64 64"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle
          cx="32"
          cy="22"
          r="12"
          fill="currentColor"
        />

        <path
          d="M12 56C14.5 43.5 21 37 32 37C43 37 49.5 43.5 52 56"
          fill="currentColor"
        />
      </svg>
    </div>

    <div class="student-info">

      <h2>
        <%= student.full_name || "" %>
      </h2>

      <div class="student-detail">
        <span class="detail-icon">☎</span>
        <span><%= student.phone_e164 || "" %></span>
      </div>

      <div class="student-detail">
        <span class="detail-icon">🎓</span>
        <span>
          Paquete: <%= student.package_name || "" %>
        </span>
      </div>

      <div class="student-detail">
        <span class="detail-icon">🏫</span>
        <span>
          Campus: <%= student.campus_name || "" %>
        </span>
      </div>

    </div>

  </article>
<section class="payment-summary">

  <div class="summary-card">
    <span class="summary-title">
      💰 Total del paquete
    </span>

    <h2>
      $<%= Number(totals.total_due || 0).toLocaleString("es-MX", {
        minimumFractionDigits:2,
        maximumFractionDigits:2
      }) %>
    </h2>
  </div>

  <div class="summary-card">
    <span class="summary-title">
      ✅ Total abonado
    </span>

    <h2>
      $<%= Number(totals.total_paid || 0).toLocaleString("es-MX", {
        minimumFractionDigits:2,
        maximumFractionDigits:2
      }) %>
    </h2>
  </div>

  <div class="summary-card">
    <span class="summary-title">
      📌 Saldo pendiente
    </span>

    <h2>
      $<%= Number(totals.balance || 0).toLocaleString("es-MX", {
        minimumFractionDigits:2,
        maximumFractionDigits:2
      }) %>
    </h2>
  </div>

</section>
</section>
  </main>

</body>

</html>
