<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1">

<title>Portal del estudiante</title>

<style>

:root{

--purple:#4400B2;
--purple-dark:#17003E;
--yellow:#FFC400;
--white:#ffffff;

}

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
.portal-app {
  width: 100%;
  max-width: 760px;
  min-height: 100vh;
  margin: 0 auto;
  padding:
    max(28px, env(safe-area-inset-top))
    26px
    60px;
}

.portal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.header-brand {
  display: flex;
  align-items: center;
  gap: 20px;
}

.header-logo {
  display: block;
  width: 255px;
  max-width: 48vw;
  height: auto;
  object-fit: contain;
}

.header-divider {
  width: 1px;
  height: 74px;
  background: rgba(255, 255, 255, 0.62);
}

.header-title {
  font-size: 28px;
  line-height: 1.08;
  font-weight: 800;
  color: #ffffff;
}

.logout-button {
  position: relative;
  flex: 0 0 auto;

  width: 54px;
  height: 54px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #ffffff;
  text-decoration: none;

  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 18px;

  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
}

.logout-button svg {
  width: 32px;
  height: 32px;
}

.notification-dot {
  position: absolute;
  top: 5px;
  right: 5px;

  width: 10px;
  height: 10px;

  border-radius: 50%;
  background: #ffc400;
}

@media (max-width: 640px) {
  .portal-app {
    padding-left: 22px;
    padding-right: 22px;
  }

  .portal-header {
    gap: 12px;
  }

  .header-brand {
    gap: 13px;
  }

  .header-logo {
    width: 250px;
    max-width: 47vw;
  }

  .header-divider {
    height: 62px;
  }

  .header-title {
    font-size: 19px;
  }

  .logout-button {
    width: 48px;
    height: 48px;
    border-radius: 15px;
  }

  .logout-button svg {
    width: 28px;
    height: 28px;
  }
}
background:

linear-gradient(
rgba(15,0,60,.18),
rgba(15,0,60,.18)
),

url("/images/leopardo-login.png")

center top

cover

no-repeat;

background-color:#17003E;

color:white;

min-height:100vh;

}
/* ===== TARJETA DEL ALUMNO ===== */

.student-card{
  display:flex;
  align-items:center;
  gap:24px;
  width:100%;
  margin:22px 0 0;
  padding:25px 28px;

  background:
    linear-gradient(
      135deg,
      rgba(68,0,178,.25),
      rgba(255,255,255,.05)
    );

  border:1px solid rgba(255,255,255,.12);
  border-radius:24px;
  backdrop-filter:blur(18px);
  box-shadow:0 16px 38px rgba(8,0,45,.20);
}

.student-avatar{
  width:112px;
  height:112px;
  flex:0 0 112px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:50%;

  background:
    linear-gradient(
      180deg,
      #eee8ff 0%,
      #c5afff 100%
    );

  color:#4400B2;

  box-shadow:
    inset 0 0 0 3px rgba(255,255,255,.28),
    0 10px 25px rgba(0,0,0,.18);
}

.student-avatar svg{
  width:78%;
  height:78%;
}

.student-info{
  min-width:0;
  flex:1;
}

.student-info h2{
  margin:0 0 12px;
  color:#ffffff;
  font-size:25px;
  line-height:1.15;
  font-weight:800;
  text-transform:uppercase;
}

.student-detail{
  display:flex;
  align-items:center;
  gap:10px;
  margin-top:9px;

  color:rgba(255,255,255,.88);
  font-size:17px;
  line-height:1.3;
}

.detail-icon{
  width:25px;
  flex:0 0 25px;
  text-align:center;
  color:#FFC400;
  font-size:20px;
}

@media(max-width:640px){

  .student-card{
    gap:16px;
    padding:20px 17px;
    border-radius:21px;
  }

  .student-avatar{
    width:88px;
    height:88px;
    flex-basis:88px;
  }

  .student-info h2{
    margin-bottom:9px;
    font-size:17px;
  }

  .student-detail{
    gap:7px;
    margin-top:6px;
    font-size:14px;
  }

  .detail-icon{
    width:20px;
    flex-basis:20px;
    font-size:16px;
  }

}
/* ===== BIENVENIDA ===== */

.welcome-section {
  margin-top: 55px;
}

.welcome-copy h1 {
  margin: 0;
  color: #ffffff;
  font-size: 34px;
  line-height: 1.15;
  font-weight: 800;
}

.welcome-copy p {
  margin: 8px 0 0;
  color: rgba(255,255,255,.72);
  font-size: 19px;
}

@media (max-width: 640px) {
  .welcome-section {
    margin-top: 42px;
  }

  .welcome-copy h1 {
    font-size: 27px;
  }

  .welcome-copy p {
    font-size: 16px;
  }

  .student-card {
    padding: 17px;
    gap: 14px;
  }

  .student-avatar {
    width: 76px;
    height: 76px;
    font-size: 35px;
  }

  .student-info h3 {
    font-size: 17px;
  }

  .student-info p {
    font-size: 14px;
    margin: 5px 0;
  }
}
/* ===== RESUMEN DE PAGOS ===== */

.payment-summary{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
    margin-top:25px;
}

.summary-card{
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.10);
    backdrop-filter:blur(12px);
    border-radius:20px;
    padding:20px;
    text-align:center;
}

.summary-title{
    display:block;
    color:rgba(255,255,255,.75);
    font-size:15px;
    margin-bottom:10px;
}

.summary-card h2{
    color:#fff;
    font-size:28px;
    margin:0;
    font-weight:700;
}

@media(max-width:768px){

.payment-summary{
grid-template-columns:1fr;
}

.summary-card h2{
font-size:24px;
}

}
/* ===== CONTADOR ===== */

.graduation-countdown{
    margin:28px 0;
    display:grid;
    grid-template-columns:1.3fr repeat(4,1fr);
    gap:0;
    background:rgba(255,255,255,.07);
    border:1px solid rgba(255,255,255,.10);
    border-radius:24px;
    overflow:hidden;
    backdrop-filter:blur(18px);
}

.countdown-intro{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    padding:22px;
}

.countdown-cap{
    font-size:42px;
}

.countdown-intro p{
    color:#fff;
    font-size:18px;
    line-height:1.3;
    font-weight:600;
}

.countdown-item{
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    padding:22px 10px;
    border-left:1px solid rgba(255,196,0,.35);
}

.countdown-item strong{
    font-size:48px;
    color:#fff;
    font-weight:800;
    line-height:1;
}

.countdown-item span{
    margin-top:8px;
    font-size:14px;
    color:rgba(255,255,255,.80);
}

@media(max-width:768px){

  .graduation-countdown{
    grid-template-columns:1.35fr repeat(4,minmax(0,1fr));
    margin:24px 0;
    border-radius:18px;
  }

  .countdown-intro{
    flex-direction:column;
    gap:5px;
    padding:14px 6px;
    text-align:center;
  }

  .countdown-cap{
    font-size:27px;
  }

  .countdown-intro p{
    font-size:11px;
    line-height:1.15;
  }

  .countdown-item{
    padding:15px 3px;
    border-top:none;
    border-left:1px solid rgba(255,196,0,.45);
  }

  .countdown-item strong{
    font-size:27px;
  }

  .countdown-item span{
    margin-top:7px;
    font-size:9px;
  }

}
/* ===== TARJETA PDF ===== */

.pdf-download-card{
    margin-top:22px;
    padding:18px 22px;

    display:flex;
    align-items:center;
    gap:18px;

    text-decoration:none;
    color:#ffffff;

    background:rgba(255,255,255,.07);
    border:1px solid rgba(255,255,255,.10);
    border-radius:22px;

    backdrop-filter:blur(18px);

    transition:.25s ease;
}

.pdf-download-card:hover{
    transform:translateY(-2px);
    border-color:#FFC400;
}

.pdf-download-icon{
    width:62px;
    height:62px;

    border-radius:18px;

    background:#d32f2f;

    display:flex;
    align-items:center;
    justify-content:center;

    color:#fff;
    font-weight:800;
    font-size:18px;

    flex-shrink:0;
}

.pdf-download-copy{
    flex:1;
}

.pdf-download-copy strong{
    display:block;
    font-size:18px;
    margin-bottom:5px;
}

.pdf-download-copy span{
    color:rgba(255,255,255,.75);
    font-size:14px;
}

.pdf-download-arrow{
    font-size:34px;
    color:#FFC400;
    font-weight:bold;
}

@media(max-width:640px){

    .pdf-download-card{
        padding:16px;
        gap:14px;
    }

    .pdf-download-icon{
        width:54px;
        height:54px;
        font-size:16px;
    }

    .pdf-download-copy strong{
        font-size:16px;
    }

    .pdf-download-copy span{
        font-size:13px;
    }

    .pdf-download-arrow{
        font-size:28px;
    }

}
/* ===== REDES SOCIALES ===== */

.social-section{
  margin-top:24px;
  padding:20px;

  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.10);
  border-radius:24px;

  backdrop-filter:blur(18px);
}

.social-heading{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;

  margin-bottom:16px;
}

.social-heading h2{
  margin:0;

  color:#ffffff;
  font-size:22px;
  font-weight:800;
}

.social-heading a{
  display:flex;
  align-items:center;
  gap:6px;

  color:#FFC400;
  font-size:15px;
  font-weight:700;
  text-decoration:none;
}

.social-heading a span{
  font-size:24px;
  line-height:1;
}

.social-card{
  display:grid;
  grid-template-columns:46% 1fr;
  min-height:180px;

  overflow:hidden;
  border-radius:18px;

  background:
    linear-gradient(
      135deg,
      rgba(68,0,178,.55),
      rgba(23,0,62,.75)
    );

  border:1px solid rgba(255,255,255,.09);
}

.social-image{
  min-height:180px;
}

.social-image img{
  display:block;
  width:100%;
  height:100%;
  min-height:180px;
  object-fit:cover;
}

.social-content{
  display:flex;
  flex-direction:column;
  justify-content:center;

  padding:20px;
}

.social-content strong{
  color:#ffffff;
  font-size:18px;
  line-height:1.3;
}

.social-content p{
  margin:13px 0 6px;

  color:rgba(255,255,255,.76);
  font-size:15px;
  line-height:1.45;
}

.social-content span{
  color:#FFC400;
  font-size:15px;
  font-weight:700;
}

@media(max-width:640px){

  .social-section{
    padding:16px;
    border-radius:21px;
  }

  .social-heading h2{
    font-size:19px;
  }

  .social-heading a{
    font-size:13px;
  }

  .social-card{
    grid-template-columns:44% 1fr;
    min-height:145px;
  }

  .social-image,
  .social-image img{
    min-height:145px;
  }

  .social-content{
    padding:14px;
  }

  .social-content strong{
    font-size:14px;
  }

  .social-content p,
  .social-content span{
    font-size:12px;
  }

}
/* ===== MENÚ INFERIOR ===== */

.bottom-nav{
  position:sticky;
  bottom:14px;
  z-index:50;

  width:100%;
  margin-top:26px;
  padding:10px;

  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:8px;

  background:rgba(31,0,83,.94);
  border:1px solid rgba(255,255,255,.12);
  border-radius:24px;

  backdrop-filter:blur(20px);
  box-shadow:0 16px 40px rgba(0,0,0,.28);
}

.bottom-nav a{
  min-width:0;
  min-height:82px;
  padding:10px 5px;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:7px;

  color:rgba(255,255,255,.82);
  text-align:center;
  text-decoration:none;

  border-radius:17px;
  transition:.2s ease;
}

.bottom-nav a:hover{
  background:rgba(255,255,255,.07);
}

.bottom-nav a.active{
  color:#ffffff;
  background:linear-gradient(
    180deg,
    rgba(68,0,178,.92),
    rgba(50,0,132,.92)
  );
}

.bottom-nav .nav-icon{
  font-size:27px;
  line-height:1;
}

.bottom-nav a.active .nav-icon{
  filter:drop-shadow(0 4px 8px rgba(255,196,0,.22));
}

.bottom-nav a span{
  font-size:12px;
  line-height:1.15;
  font-weight:700;
}

@media(max-width:640px){

  .portal-app{
    padding-bottom:28px;
  }

  .bottom-nav{
    bottom:10px;
    gap:5px;
    padding:8px;
    border-radius:21px;
  }

  .bottom-nav a{
    min-height:75px;
    padding:8px 3px;
    border-radius:15px;
  }

  .bottom-nav .nav-icon{
    font-size:23px;
  }

  .bottom-nav a span{
    font-size:10px;
  }

}
/* ===== HISTORIAL DE PAGOS ===== */

.payments-history-section{
  margin-top:24px;
  padding:20px;

  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.10);
  border-radius:24px;

  backdrop-filter:blur(18px);
}

.payments-history-header{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:16px;
  margin-bottom:18px;
}

.payments-history-header h2{
  margin:0;
  color:#ffffff;
  font-size:24px;
  font-weight:800;
}

.payments-history-header p{
  margin:6px 0 0;
  color:rgba(255,255,255,.70);
  font-size:14px;
  line-height:1.4;
}

.payments-count{
  flex-shrink:0;
  padding:8px 12px;

  color:#17003E;
  background:#FFC400;

  border-radius:999px;

  font-size:12px;
  font-weight:800;
}

.payments-list{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.payment-history-card{
  display:grid;
  grid-template-columns:44px 1fr auto;
  align-items:center;
  gap:14px;

  padding:16px;

  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.09);
  border-radius:18px;
}

.payment-history-number{
  width:44px;
  height:44px;

  display:flex;
  align-items:center;
  justify-content:center;

  color:#17003E;
  background:#FFC400;

  border-radius:14px;

  font-size:16px;
  font-weight:800;
}

.payment-history-info{
  min-width:0;

  display:flex;
  flex-direction:column;
  gap:4px;
}

.payment-history-info strong{
  color:#ffffff;
  font-size:15px;
}

.payment-history-info span{
  color:rgba(255,255,255,.68);
  font-size:12px;
}

.payment-history-amount{
  color:#ffffff;
  font-size:18px;
  font-weight:800;
  white-space:nowrap;
}

.payments-empty{
  padding:24px;
  text-align:center;

  background:rgba(255,255,255,.05);
  border:1px dashed rgba(255,255,255,.16);
  border-radius:18px;
}

.payments-empty strong{
  display:block;
  color:#ffffff;
  font-size:16px;
}

.payments-empty p{
  margin:7px 0 0;
  color:rgba(255,255,255,.68);
  font-size:13px;
}

.payments-pdf-button{
  margin-top:16px;
  padding:16px 18px;

  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;

  color:#17003E;
  text-decoration:none;

  background:#ffffff;
  border-radius:18px;

  transition:.2s ease;
}

.payments-pdf-button:hover{
  transform:translateY(-2px);
}

.payments-pdf-button strong{
  display:block;
  font-size:16px;
  font-weight:800;
}

.payments-pdf-button span{
  display:block;
  margin-top:4px;
  color:rgba(23,0,62,.65);
  font-size:12px;
}

.payments-pdf-arrow{
  color:#FFC400 !important;
  font-size:32px !important;
  font-weight:800;
}

@media(max-width:640px){

  .payments-history-section{
    padding:16px;
    border-radius:21px;
  }

  .payments-history-header h2{
    font-size:20px;
  }

  .payment-history-card{
    grid-template-columns:40px 1fr;
    gap:12px;
  }

  .payment-history-number{
    width:40px;
    height:40px;
  }

  .payment-history-amount{
    grid-column:2;
    font-size:17px;
  }

}
</style>

</head>

<body>

  <main class="portal-app">

    <header class="portal-header">

      <div class="header-brand">

        <img
          class="header-logo"
          src="/images/logo-itcc.png"
          alt="Universidad y Preparatoria ITCC"
        >

        <div class="header-divider"></div>

        <div class="header-title">
          Portal del<br>
          estudiante
        </div>

      </div>

      <a
        class="logout-button"
        href="/portal/logout"
        aria-label="Cerrar sesión"
      >
        <span class="notification-dot"></span>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M18 8A6 6 0 0 0 6 8c0 7-3 7-3 9h18c0-2-3-2-3-9"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <path
            d="M10 21h4"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </a>

    </header>
<section class="welcome-section">

  <div class="welcome-copy">
    <h1>
      ¡Hola,
      <%= String(student.full_name || "").split(" ")[0] %>! 👋
    </h1>

    <p>
      Bienvenido a tu portal de graduación
    </p>
  </div>
<section class="graduation-countdown">

  <div class="countdown-intro">

    <div class="countdown-cap">
      🎓
    </div>

    <p>
      Faltan para tu<br>
      graduación
    </p>

  </div>

  <div class="countdown-item">
    <strong id="countdown-days">00</strong>
    <span>DÍAS</span>
  </div>

  <div class="countdown-item">
    <strong id="countdown-hours">00</strong>
    <span>HORAS</span>
  </div>

  <div class="countdown-item">
    <strong id="countdown-minutes">00</strong>
    <span>MINUTOS</span>
  </div>

  <div class="countdown-item">
    <strong id="countdown-seconds">00</strong>
    <span>SEGUNDOS</span>
  </div>

</section>
  <article class="student-card">

    <div class="student-avatar" aria-hidden="true">
      <svg
        viewBox="0 0 64 64"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle
          cx="32"
          cy="22"
          r="12"
          fill="currentColor"
        />

        <path
          d="M12 56C14.5 43.5 21 37 32 37C43 37 49.5 43.5 52 56"
          fill="currentColor"
        />
      </svg>
    </div>

    <div class="student-info">

      <h2>
        <%= student.full_name || "" %>
      </h2>

      <div class="student-detail">
        <span class="detail-icon">☎</span>
        <span><%= student.phone_e164 || "" %></span>
      </div>

      <div class="student-detail">
        <span class="detail-icon">🎓</span>
        <span>
          Paquete: <%= student.package_name || "" %>
        </span>
      </div>

      <div class="student-detail">
        <span class="detail-icon">🏫</span>
        <span>
          Campus: <%= student.campus_name || "" %>
        </span>
      </div>

    </div>

  </article>
<section class="payment-summary" id="mis-pagos">

  <div class="summary-card">
    <span class="summary-title">
      💰 Total del paquete
    </span>

    <h2>
      $<%= Number(totals.total_due || 0).toLocaleString("es-MX", {
        minimumFractionDigits:2,
        maximumFractionDigits:2
      }) %>
    </h2>
  </div>

  <div class="summary-card">
    <span class="summary-title">
      ✅ Total abonado
    </span>

    <h2>
