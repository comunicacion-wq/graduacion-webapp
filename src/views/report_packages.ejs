<h3 class="mb-3">
  Reporte de paquetes
</h3>

<p class="text-muted">
  Concentrado de alumnos activos pagando su graduación.
</p>

<form
  method="GET"
  action="/reports/packages"
  class="row g-2 mb-4"
>

  <div class="col-12 col-md-4">

    <label class="form-label">
      Campus
    </label>

    <select
      name="campus_id"
      class="form-select"
    >

      <option value="">
        Todos los campus
      </option>

      <% campuses.forEach(function(campus) { %>

        <option
          value="<%= campus.id %>"
          <%= String(filters.campus_id) === String(campus.id)
            ? "selected"
            : "" %>
        >
          <%= campus.name %>
        </option>

      <% }) %>

    </select>

  </div>

  <div class="col-12 col-md-4">

    <label class="form-label">
      Periodo
    </label>

    <select
      name="period_id"
      class="form-select"
    >

      <option value="">
        Todos los periodos
      </option>

      <% periods.forEach(function(period) { %>

        <option
          value="<%= period.id %>"
          <%= String(filters.period_id) === String(period.id)
            ? "selected"
            : "" %>
        >
          <%= period.name %>
        </option>

      <% }) %>

    </select>

  </div>

  <div class="col-12 col-md-4">

    <label class="form-label">
      Año
    </label>

    <select
      name="year_id"
      class="form-select"
    >

      <option value="">
        Todos los años
      </option>

      <% years.forEach(function(year) { %>

        <option
          value="<%= year.id %>"
          <%= String(filters.year_id) === String(year.id)
            ? "selected"
            : "" %>
        >
          <%= year.year %>
        </option>

      <% }) %>

    </select>

  </div>

<div class="col-12 col-md-auto d-flex align-items-end">

  <button
    type="submit"
    class="btn btn-primary w-100"
  >
    Filtrar
  </button>

</div>

<div class="col-12 col-md-auto d-flex align-items-end">

  <a
    href="/reports/packages"
    class="btn btn-outline-secondary w-100"
  >
    Limpiar
  </a>

</div>

<div class="col-12 col-md-auto d-flex align-items-end">

  <a
    href="/reports/packages.xlsx?campus_id=<%= encodeURIComponent(filters.campus_id || '') %>&period_id=<%= encodeURIComponent(filters.period_id || '') %>&year_id=<%= encodeURIComponent(filters.year_id || '') %>"
    class="btn btn-success w-100"
  >
    📊 Descargar Excel
  </a>

</div>
</form>


<div class="row g-3 mb-4">

  <div class="col-12 col-md-4">

    <div class="card h-100">
      <div class="card-body">

        <div class="text-muted small">
          Total alumnos
        </div>

        <div class="fs-3 fw-bold">
          <%= totals.total_students %>
        </div>

      </div>
    </div>

  </div>


  <div class="col-12 col-md-4">

    <div class="card h-100">
      <div class="card-body">

        <div class="text-muted small">
          Total pagado
        </div>

        <div class="fs-3 fw-bold">
          $<%= Number(totals.total_paid || 0).toLocaleString("es-MX", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }) %>
        </div>

      </div>
    </div>

  </div>


  <div class="col-12 col-md-4">

    <div class="card h-100">
      <div class="card-body">

        <div class="text-muted small">
          Saldo pendiente
        </div>

        <div class="fs-3 fw-bold">
          $<%= Number(totals.total_balance || 0).toLocaleString("es-MX", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }) %>
        </div>

      </div>
    </div>

  </div>

</div>


<div class="row g-3 mb-4">

  <div class="col-12 col-md-6">

    <div class="card h-100">
      <div class="card-body">

        <div class="text-muted small">
          Alumnos pagados
        </div>

        <div class="fs-3 fw-bold text-success">
          <%= totals.paid_students %>
        </div>

      </div>
    </div>

  </div>


  <div class="col-12 col-md-6">

    <div class="card h-100">
      <div class="card-body">

        <div class="text-muted small">
          Alumnos con saldo
        </div>

        <div class="fs-3 fw-bold text-danger">
          <%= totals.students_with_balance %>
        </div>

      </div>
    </div>

  </div>

</div>


<div class="card mb-4">

  <div class="card-body">

    <h5 class="card-title mb-3">
      Concentrado por campus y paquete
    </h5>

    <div class="table-responsive">

      <table class="table table-striped align-middle">

        <thead>

          <tr>
            <th>Campus</th>
            <th>Paquete</th>
            <th class="text-end">Alumnos</th>
            <th class="text-end">Pagados</th>
            <th class="text-end">Con saldo</th>
            <th class="text-end">Total pagado</th>
            <th class="text-end">Saldo</th>
          </tr>

        </thead>

        <tbody>

          <% if (Array.isArray(rows) && rows.length > 0) { %>

            <% rows.forEach(function(row) { %>

              <tr>

                <td>
                  <%= row.campus_name || "Sin campus" %>
                </td>

                <td>
                  <%= row.package_name || "Sin paquete" %>
                </td>

                <td class="text-end">
                  <strong>
                    <%= row.total_students %>
                  </strong>
                </td>

                <td class="text-end">
                  <%= row.paid_students || 0 %>
                </td>

                <td class="text-end">
                  <%= row.students_with_balance || 0 %>
                </td>

                <td class="text-end">
                  $<%= Number(row.total_paid || 0).toLocaleString("es-MX", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </td>

                <td class="text-end">
                  $<%= Number(row.total_balance || 0).toLocaleString("es-MX", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </td>

              </tr>

            <% }) %>

          <% } else { %>

            <tr>

              <td
                colspan="7"
                class="text-center text-muted py-4"
              >
                No hay alumnos para mostrar con los filtros seleccionados.
              </td>

            </tr>

          <% } %>

        </tbody>

      </table>

    </div>

  </div>

</div>


<div class="card">

  <div class="card-body">

    <h5 class="card-title mb-3">
      Detalle de alumnos
    </h5>

    <div class="table-responsive">

      <table class="table table-striped table-hover align-middle">

        <thead>

          <tr>
            <th>Alumno</th>
            <th>Teléfono</th>
            <th>Campus</th>
            <th>Turno</th>
            <th>Grado</th>
            <th>Grupo</th>
            <th>Periodo</th>
            <th>Año</th>
            <th>Paquete</th>
            <th class="text-end">Costo</th>
            <th class="text-end">Descuento</th>
            <th class="text-end">Pagado</th>
            <th class="text-end">Saldo</th>
            <th>Estado</th>
          </tr>

        </thead>

        <tbody>

          <% if (
            Array.isArray(studentsDetail) &&
            studentsDetail.length > 0
          ) { %>

            <% studentsDetail.forEach(function(student) { %>

              <tr>

                <td>
                  <strong>
                    <%= student.full_name || "" %>
                  </strong>
                </td>

                <td>
                  <%= student.phone_e164 || "" %>
                </td>

                <td>
                  <%= student.campus_name || "" %>
                </td>

                <td>
                  <%= student.shift_name || "" %>
                </td>

                <td>
                  <%= student.grade || "" %>
                </td>

                <td>
                  <%= student.group || "" %>
                </td>

                <td>
                  <%= student.period_name || "" %>
                </td>

                <td>
                  <%= student.grad_year || "" %>
                </td>

                <td>
                  <%= student.package_name || "" %>
                </td>

                <td class="text-end">
                  $<%= Number(student.package_cost || 0).toLocaleString("es-MX", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </td>

                <td class="text-end">
                  $<%= Number(student.discount_amount || 0).toLocaleString("es-MX", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </td>

                <td class="text-end">
                  $<%= Number(student.total_paid || 0).toLocaleString("es-MX", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </td>

                <td class="text-end">
                  $<%= Number(student.balance || 0).toLocaleString("es-MX", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </td>

                <td>

                  <% if (student.payment_status === "PAGADO") { %>

                    <span class="badge bg-success">
                      PAGADO
                    </span>

                  <% } else { %>

                    <span class="badge bg-warning text-dark">
                      CON SALDO
                    </span>

                  <% } %>

                </td>

              </tr>

            <% }) %>

          <% } else { %>

            <tr>

              <td
                colspan="14"
                class="text-center text-muted py-4"
              >
                No hay alumnos para mostrar.
              </td>

            </tr>

          <% } %>

        </tbody>

      </table>

    </div>

  </div>

</div>
