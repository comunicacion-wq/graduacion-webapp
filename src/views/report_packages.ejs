<h3 class="mb-3">
  Reporte de paquetes
</h3>

<p class="text-muted">
  Concentrado de alumnos por campus, periodo, año y paquete de graduación.
</p>

<form
  method="GET"
  action="/reports/packages"
  class="row g-2 mb-4"
>

  <div class="col-12 col-md-4">

    <label class="form-label">
      Campus
    </label>

    <select
      name="campus_id"
      class="form-select"
    >

      <option value="">
        Todos los campus
      </option>

      <% campuses.forEach(function(campus) { %>

        <option
          value="<%= campus.id %>"
          <%= String(filters.campus_id) === String(campus.id)
            ? "selected"
            : "" %>
        >
          <%= campus.name %>
        </option>

      <% }) %>

    </select>

  </div>


  <div class="col-12 col-md-4">

    <label class="form-label">
      Periodo
    </label>

    <select
      name="period_id"
      class="form-select"
    >

      <option value="">
        Todos los periodos
      </option>

      <% periods.forEach(function(period) { %>

        <option
          value="<%= period.id %>"
          <%= String(filters.period_id) === String(period.id)
            ? "selected"
            : "" %>
        >
          <%= period.name %>
        </option>

      <% }) %>

    </select>

  </div>


  <div class="col-12 col-md-4">

    <label class="form-label">
      Año
    </label>

    <select
      name="year_id"
      class="form-select"
    >

      <option value="">
        Todos los años
      </option>

      <% years.forEach(function(year) { %>

        <option
          value="<%= year.id %>"
          <%= String(filters.year_id) === String(year.id)
            ? "selected"
            : "" %>
        >
          <%= year.year %>
        </option>

      <% }) %>

    </select>

  </div>


  <div class="col-12 col-md-auto d-flex align-items-end">

    <button
      type="submit"
      class="btn btn-primary w-100"
    >
      Filtrar
    </button>

  </div>


  <div class="col-12 col-md-auto d-flex align-items-end">

    <a
      href="/reports/packages"
      class="btn btn-outline-secondary w-100"
    >
      Limpiar
    </a>

  </div>

</form>


<div class="card mb-4">

  <div class="card-body">

    <div class="text-muted">
      Total de alumnos
    </div>

    <div
      style="
        font-size:32px;
        font-weight:700;
      "
    >
      <%= totalStudents %>
    </div>

  </div>

</div>


<div class="card">

  <div class="card-body">

    <h5 class="card-title mb-3">
      Concentrado por campus y paquete
    </h5>

    <div class="table-responsive">

      <table class="table table-striped align-middle">

        <thead>

          <tr>
            <th>Campus</th>
            <th>Paquete</th>
            <th class="text-end">
              Alumnos
            </th>
          </tr>

        </thead>

        <tbody>

          <% if (Array.isArray(rows) && rows.length > 0) { %>

            <% rows.forEach(function(row) { %>

              <tr>

                <td>
                  <%= row.campus_name || "Sin campus" %>
                </td>

                <td>
                  <%= row.package_name || "Sin paquete" %>
                </td>

                <td class="text-end">

                  <strong>
                    <%= row.total_students %>
                  </strong>

                </td>

              </tr>

            <% }) %>

          <% } else { %>

            <tr>

              <td
                colspan="3"
                class="text-center text-muted py-4"
              >
                No hay alumnos para mostrar con los filtros seleccionados.
              </td>

            </tr>

          <% } %>

        </tbody>

      </table>

    </div>

  </div>

</div>
