<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Grupos a egresar</h2>

  <a class="btn btn-outline-secondary" href="/students">
    Volver
  </a>
</div>

<div class="card">
  <div class="card-body">

    <form method="GET" action="/students/graduation-groups">

      <div class="row g-3">

      <div class="col-md-3">
        <label class="form-label">Campus</label>
       <select class="form-select" name="campus_id">
  <option value="">Todos</option>
  <% campuses.forEach(c => { %>
    <option value="<%= c.id %>" <%= String(filters.campus_id) === String(c.id) ? 'selected' : '' %>>
      <%= c.name %>
    </option>
  <% }) %>
</select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Turno</label>
       <select class="form-select" name="shift_id">
  <option value="">Todos</option>
  <% shifts.forEach(s => { %>
    <option value="<%= s.id %>" <%= String(filters.shift_id) === String(s.id) ? 'selected' : '' %>>
      <%= s.name %>
    </option>
  <% }) %>
</select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Periodo</label>
       <select class="form-select" name="period_id">
  <option value="">Todos</option>
  <% periods.forEach(p => { %>
    <option value="<%= p.id %>" <%= String(filters.period_id) === String(p.id) ? 'selected' : '' %>>
      <%= p.name %>
    </option>
  <% }) %>
</select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Año</label>
      <select class="form-select" name="year_id">
  <option value="">Todos</option>
  <% years.forEach(y => { %>
    <option value="<%= y.id %>" <%= String(filters.year_id) === String(y.id) ? 'selected' : '' %>>
      <%= y.year %>
    </option>
  <% }) %>
</select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Carrera</label>
<select class="form-select" name="career_id">
  <option value="">Todas</option>
  <% careers.forEach(c => { %>
    <option value="<%= c.id %>" <%= String(filters.career_id) === String(c.id) ? 'selected' : '' %>>
      <%= c.name %>
    </option>
  <% }) %>
</select>
      </div>

    <div class="col-md-3">
  <label class="form-label">Grado</label>
  <select class="form-select" name="grade">
    <option value="">Todos</option>
    <% grades.forEach(g => { %>
      <option value="<%= g.grade %>" <%= filters.grade === g.grade ? 'selected' : '' %>>
        <%= g.grade %>
      </option>
    <% }) %>
  </select>
</div>

     <div class="col-md-3">
  <label class="form-label">Grupo</label>
  <select class="form-select" name="group">
    <option value="">Todos</option>
    <% groupsList.forEach(g => { %>
      <option value="<%= g.group %>" <%= filters.group === g.group ? 'selected' : '' %>>
        <%= g.group %>
      </option>
    <% }) %>
  </select>
</div>

    </div>

    <hr>

    <div class="mb-3">
      <label class="form-label d-block">Nivel</label>

      <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox">
        <label class="form-check-label">
          Bachillerato
        </label>
      </div>

      <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox">
        <label class="form-check-label">
          Universidad
        </label>
      </div>
    </div>

<button class="btn btn-primary">
  Filtrar grupos
</button>

    </form>
<% if (summary) { %>
  <hr>

  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <small>Total alumnos</small>
          <h3><%= summary.total_alumnos || 0 %></h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <small>Total grupos</small>
          <h3><%= summary.total_grupos || 0 %></h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <small>Bachillerato</small>
          <h3><%= summary.bachillerato || 0 %></h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <small>Universidad</small>
          <h3><%= summary.universidad || 0 %></h3>
        </div>
      </div>
    </div>
  </div>

  <table class="table table-sm table-striped">
    <thead>
      <tr>
        <th>Campus</th>
        <th>Turno</th>
        <th>Periodo</th>
        <th>Año</th>
        <th>Carrera</th>
        <th>Grado</th>
        <th>Grupo</th>
       <th>Total</th>
<th>Lista</th>
      </tr>
    </thead>
    <tbody>
      <% groups.forEach(g => { %>
        <tr>
          <td><%= g.campus || '' %></td>
          <td><%= g.turno || '' %></td>
          <td><%= g.periodo || '' %></td>
          <td><%= g.anio || '' %></td>
          <td><%= g.carrera || '' %></td>
          <td><%= g.grado || '' %></td>
          <td><%= g.grupo || '' %></td>
          <td><strong><%= g.total %></strong></td>
<td>
  <a class="btn btn-sm btn-outline-danger"
     target="_blank"
     href="/students/graduation-groups/pdf?campus=<%= encodeURIComponent(g.campus || '') %>&turno=<%= encodeURIComponent(g.turno || '') %>&periodo=<%= encodeURIComponent(g.periodo || '') %>&anio=<%= encodeURIComponent(g.anio || '') %>&carrera=<%= encodeURIComponent(g.carrera || '') %>&grado=<%= encodeURIComponent(g.grado || '') %>&grupo=<%= encodeURIComponent(g.grupo || '') %>">
    Descargar lista PDF
  </a>
</td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
  </div>
</div>
