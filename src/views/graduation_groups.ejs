<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Grupos a egresar</h2>

  <a class="btn btn-outline-secondary" href="/students">
    Volver
  </a>
</div>

<div class="card">
  <div class="card-body">

    <div class="row g-3">

      <div class="col-md-3">
        <label class="form-label">Campus</label>
        <select class="form-select">
          <option>Todos</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Turno</label>
        <select class="form-select">
          <option>Todos</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Periodo</label>
        <select class="form-select">
          <option>Todos</option>
          <option>Enero-Abril</option>
          <option>Mayo-Agosto</option>
          <option>Septiembre-Diciembre</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Año</label>
        <select class="form-select">
          <option>2026</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Carrera</label>
        <select class="form-select">
          <option>Todas</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Grado</label>
        <input type="text" class="form-control" placeholder="Ejemplo: 6">
      </div>

      <div class="col-md-3">
        <label class="form-label">Grupo</label>
        <input type="text" class="form-control" placeholder="Ejemplo: A">
      </div>

    </div>

    <hr>

    <div class="mb-3">
      <label class="form-label d-block">Nivel</label>

      <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox">
        <label class="form-check-label">
          Bachillerato
        </label>
      </div>

      <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox">
        <label class="form-check-label">
          Universidad
        </label>
      </div>
    </div>

    <button class="btn btn-primary">
      Filtrar grupos
    </button>

  </div>
</div>
